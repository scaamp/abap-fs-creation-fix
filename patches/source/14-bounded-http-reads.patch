@@ -0,0 +1,15 @@
+import axios from "axios"
+import { AxiosHttpClient } from "./AxiosHttpClient"
+
+test("passes optional response and redirect bounds without changing defaults for existing callers", async () => {
+  const request = jest.fn().mockResolvedValue({ data: "<ok/>", status: 200, statusText: "OK", headers: {} })
+  const create = jest.spyOn(axios, "create").mockReturnValue({ request } as unknown as ReturnType<typeof axios.create>)
+  try {
+    const client = new AxiosHttpClient("https://example.invalid")
+    await client.request({url:"/sap/example",method:"GET",maxRedirects:0,maxContentLength:1024})
+    expect(request.mock.calls[0][0]).toMatchObject({method:"GET",maxRedirects:0,maxContentLength:1024})
+    await client.request({url:"/sap/legacy"})
+    expect(request.mock.calls[1][0].maxRedirects).toBeUndefined()
+    expect(request.mock.calls[1][0].maxContentLength).toBeUndefined()
+  } finally { create.mockRestore() }
+})
