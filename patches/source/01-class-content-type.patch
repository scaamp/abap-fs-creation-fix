+import { AdtHTTP } from "../AdtHTTP"
+import { fullParse } from "../utilities"
+import { createObject, NewObjectOptions } from "./objectcreator"
+
+const v4 = "application/vnd.sap.adt.oo.classes.v4+xml"
+const options: NewObjectOptions = {
+  objtype: "CLAS/OC",
+  name: "ZCL_EXAMPLE",
+  description: 'Example & "class"',
+  parentName: "ZEXAMPLE",
+  parentPath: "/sap/bc/adt/packages/zexample"
+}
+
+function setup(accept = v4, href = "/sap/bc/adt/oo/classes") {
+  const http = new AdtHTTP(
+    "https://example.invalid",
+    "alias@example.invalid",
+    "unused",
+    "001",
+    "de"
+  )
+  const request = jest.spyOn(http, "request").mockImplementation(async url => ({
+    status: 200,
+    statusText: "OK",
+    headers: {},
+    body:
+      url === "/sap/bc/adt/discovery"
+        ? `<app:service xmlns:app="http://www.w3.org/2007/app"><app:workspace><app:collection href="${href}"><app:accept>${accept}</app:accept></app:collection></app:workspace></app:service>`
+        : ""
+  }))
+  return { http, request }
+}
+
+describe("class creation media negotiation", () => {
+  test("uses V4 only when advertised by the class collection", async () => {
+    const { http, request } = setup()
+    await createObject(http, { ...options, transport: "EXAMPLE_REQUEST" })
+    expect(request.mock.calls[1]).toEqual([
+      "/sap/bc/adt/oo/classes",
+      expect.objectContaining({
+        method: "POST",
+        headers: { "Content-Type": v4 },
+        qs: { corrNr: "EXAMPLE_REQUEST" }
+      })
+    ])
+  })
+
+  test.each([
+    ["application/xml", "/sap/bc/adt/oo/classes"],
+    [v4, "/sap/bc/adt/oo/interfaces"],
+    ["", "/sap/bc/adt/oo/classes"]
+  ])("preserves legacy creation for %s on %s", async (accept, href) => {
+    const { http, request } = setup(accept, href)
+    await createObject(http, { ...options })
+    const config = request.mock.calls[1][1]!
+    expect(config.headers).toEqual({ "Content-Type": "application/*" })
+    expect(config.body).not.toContain("class:superClassRef")
+  })
+
+  test("does not POST when discovery fails", async () => {
+    const { http, request } = setup()
+    request.mockRejectedValue(new Error("Discovery failed"))
+    await expect(createObject(http, { ...options })).rejects.toThrow("Discovery failed")
+    expect(request).toHaveBeenCalledTimes(1)
+  })
+
+  test("does not retry a rejected POST", async () => {
+    const { http, request } = setup()
+    request.mockImplementationOnce(async () => ({
+      status: 200,
+      statusText: "OK",
+      headers: {},
+      body: `<app:service><app:workspace><app:collection href="/sap/bc/adt/oo/classes"><app:accept>${v4}</app:accept></app:collection></app:workspace></app:service>`
+    }))
+    request.mockRejectedValue(new Error("Creation failed"))
+    await expect(createObject(http, { ...options })).rejects.toThrow("Creation failed")
+    expect(request).toHaveBeenCalledTimes(2)
+  })
+})
