+import { XMLParser, XMLValidator } from "fast-xml-parser"
+import { AdtHTTP } from "../AdtHTTP"
+import { externalRepoInfo, GitRepo, GitStaging, pushRepo, stageRepo } from "./abapgit"
+
+const repo: GitRepo = {
+  key: "example", sapPackage: "ZEXAMPLE", url: "https://git.example/repo.git",
+  branch_name: "refs/heads/main", created_by: "example", created_at: new Date(0),
+  links: [
+    { type: "stage_link", rel: "stage", href: "/sap/bc/adt/abapgit/repos/example/stage" },
+    { type: "push_link", rel: "push", href: "/sap/bc/adt/abapgit/repos/example/push" }
+  ]
+}
+const parser = new XMLParser({ ignoreAttributes: false, processEntities: true, htmlEntities: true })
+
+test("commit+push XML preserves author, committer, multiline comment and XML-special paths", async () => {
+  const request = jest.fn().mockResolvedValue({ body: "" })
+  const staging: GitStaging = {
+    staged: [{ wbkey: 'CLAS Z"&TEST', uri: '/example?x=1&y=2', type: "CLAS", name: "ZEXAMPLE",
+      abapGitFiles: [{ name: 'z"&test.clas.abap', path: "/src/", localState: "M",
+        links: [{ rel: "localversion", href: "/example?x=1&y=2" }] }] }],
+    unstaged: [], ignored: [], comment: 'Fix "A&B"\nDetails <checked>',
+    author: { name: 'Author "A&B"', email: "author@example.invalid" },
+    committer: { name: "Different committer", email: "committer@example.invalid" }
+  }
+  await pushRepo({ request } as unknown as AdtHTTP, repo, staging, "example", "example-secret")
+  const [, options] = request.mock.calls[0]
+  expect(options.method).toBe("POST")
+  expect(options.headers["Content-Type"]).toBe("application/abapgit.adt.repo.stage.v1+xml")
+  expect(XMLValidator.validate(options.body)).toBe(true)
+  const parsed = parser.parse(options.body)["abapgitstaging:abapgitstaging"]
+  const comment = parsed["abapgitstaging:abapgit_comment"]
+  expect(comment["@_abapgitstaging:comment"]).toBe(staging.comment)
+  expect(comment["abapgitstaging:author"]["@_abapgitstaging:name"]).toBe(staging.author.name)
+  const object = parsed["abapgitstaging:staged_objects"]["abapgitstaging:abapgitobject"]
+  expect(object["@_abapgitstaging:wbkey"]).toBe(staging.staged[0].wbkey)
+  expect(object["abapgitstaging:abapgitfile"]["@_abapgitstaging:name"]).toBe(staging.staged[0].abapGitFiles[0].name)
+  const readRequest = jest.fn().mockResolvedValue({ body: options.body })
+  const read = await stageRepo({ request: readRequest } as unknown as AdtHTTP, repo)
+  expect(read.author).toEqual(staging.author)
+  expect(read.committer).toEqual(staging.committer)
+  expect(readRequest.mock.calls[0][1].method).toBeUndefined()
+})
+
+test("remote refs XML escapes URL and credential values without changing the transmitted values", async () => {
+  const request = jest.fn().mockResolvedValue({ body: "<externalRepoInfo/>" })
+  const url = "https://git.example/repo?x=1&y=2"
+  const secret = 'fake<&"secret'
+  await externalRepoInfo({ request } as unknown as AdtHTTP, url, 'example&user', secret)
+  const body = request.mock.calls[0][1].body
+  expect(XMLValidator.validate(body)).toBe(true)
+  const parsed = parser.parse(body)["abapgitexternalrepo:externalRepoInfoRequest"]
+  expect(parsed["abapgitexternalrepo:password"]).toBe(secret)
+  expect(parsed["abapgitexternalrepo:url"]).toBe(url)
+})
