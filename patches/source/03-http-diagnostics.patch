+++ b/src/requestLogger.test.ts
@@ -0,0 +1,114 @@
+import { AdtHTTP, HttpClient, HttpClientException, HttpClientResponse } from "./AdtHTTP"
+import { isAdtError } from "./AdtException"
+import { LogData } from "./requestLogger"
+
+const body = `<exc:exception xmlns:exc="http://www.sap.com/abapxml/types/communicationframework"><namespace id="adt"/><type id="CLASS_TRANSFORMATION"/><message>Cannot deserialize class</message></exc:exception>`
+
+describe("HTTP error diagnostics", () => {
+  test.each([true, false])(
+    "preserves the ADT response for throwing transport = %s",
+    async throws => {
+      const entries: LogData[] = []
+      const response: HttpClientResponse = {
+        status: 400,
+        statusText: "Bad Request",
+        body,
+        headers: {
+          "content-type": "application/xml",
+          "set-cookie": ["private-cookie"],
+          "X-CSRF-Token": "private-token"
+        }
+      }
+      const transport: HttpClient = {
+        request: async options => {
+          if (options.url === "/sap/bc/adt/compatibility/graph")
+            return {
+              status: 200,
+              statusText: "OK",
+              headers: { "x-csrf-token": "private-token" },
+              body: ""
+            }
+          if (throws)
+            throw new HttpClientException(
+              "Bad Request",
+              undefined,
+              400,
+              undefined,
+              options,
+              response
+            )
+          return response
+        }
+      }
+      const http = new AdtHTTP(transport, "example", "private-password", "001", "EN", {
+        debugCallback: entry => entries.push(entry)
+      })
+      const error = await http
+        .request("/sap/bc/adt/oo/classes", {
+          method: "POST",
+          body: "<class/>",
+          headers: {
+            Authorization: "private-bearer",
+            Cookie: "private-cookie",
+            "Proxy-Authorization": "private-proxy"
+          }
+        })
+        .catch(error => error)
+      expect(isAdtError(error)).toBe(true)
+      expect(error.response.body).toBe(body)
+      const entry = entries[entries.length - 1]
+      expect(entry.response.statusCode).toBe(400)
+      expect(entry.response.body).toBe(body)
+      expect(entry.response.headers["content-type"]).toBe("application/xml")
+      expect(entry.request.body).toBe("<class/>")
+      expect(entry.error).toBeInstanceOf(Error)
+      const serialized = JSON.stringify(entry)
+      for (const secret of [
+        "private-password",
+        "private-token",
+        "private-cookie",
+        "private-bearer",
+        "private-proxy"
+      ])
+        expect(serialized).not.toContain(secret)
+      expect(response.headers["set-cookie"]).toEqual(["private-cookie"])
+    }
+  )
+
+  test("preserves non-XML HTTP errors and reports network failures without invented status", async () => {
+    const entries: LogData[] = []
+    const transport: HttpClient = {
+      request: async options => {
+        if (options.url === "/sap/bc/adt/compatibility/graph")
+          return { status: 200, statusText: "OK", headers: { "x-csrf-token": "example" }, body: "" }
+        const response =
+          options.url === "/http-error"
+            ? {
+                status: 502,
+                statusText: "Bad Gateway",
+                headers: {},
+                body: "<html>Gateway unavailable</html>"
+              }
+            : undefined
+        throw new HttpClientException(
+          "Request failed",
+          undefined,
+          response?.status,
+          undefined,
+          options,
+          response
+        )
+      }
+    }
+    const http = new AdtHTTP(transport, "example", "unused", "001", "EN", {
+      debugCallback: entry => entries.push(entry)
+    })
+    await expect(http.request("/http-error")).rejects.toBeDefined()
+    expect(entries[entries.length - 1].response).toMatchObject({
+      statusCode: 502,
+      body: "<html>Gateway unavailable</html>"
+    })
+    await expect(http.request("/network-error")).rejects.toBeDefined()
+    expect(entries[entries.length - 1].response.statusCode).toBe(0)
+  })
+})
