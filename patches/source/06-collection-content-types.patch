diff --git a/src/api/creationmedia.test.ts b/src/api/creationmedia.test.ts
new file mode 100644
--- /dev/null
+++ b/src/api/creationmedia.test.ts
@@ -0,0 +1,48 @@
+import { AdtHTTP } from "../AdtHTTP"
+import { createObject, NewObjectOptions } from "./objectcreator"
+
+const contracts: [NewObjectOptions["objtype"], string, string][] = [
+  ["DCLS/DL", "acm/dcl/sources", "application/vnd.sap.adt.dclSource+xml"],
+  ["INTF/OI", "oo/interfaces", "application/vnd.sap.adt.oo.interfaces.v5+xml"],
+  ["TABL/DT", "ddic/tables", "application/vnd.sap.adt.tables.v2+xml"],
+  ["TABL/DS", "ddic/structures", "application/vnd.sap.adt.structures.v2+xml"],
+  ["DTEL/DE", "ddic/dataelements", "application/vnd.sap.adt.dataelements.v2+xml"],
+  ["DOMA/DD", "ddic/domains", "application/vnd.sap.adt.domains.v2+xml"],
+  ["TTYP/DA", "ddic/tabletypes", "application/vnd.sap.adt.tabletype.v1+xml"],
+  ["DDLX/EX", "ddic/ddlx/sources", "application/vnd.sap.adt.ddic.ddlx.v1+xml"],
+  ["SRVD/SRV", "ddic/srvd/sources", "application/vnd.sap.adt.ddic.srvd.v1+xml"],
+  ["AUTH", "aps/iam/auth", "application/vnd.sap.adt.blues.v1+xml"],
+  ["SUSO/B", "aps/iam/suso", "application/vnd.sap.adt.blues.v1+xml"],
+  ["DEVC/K", "packages", "application/vnd.sap.adt.packages.v2+xml"],
+  ["FUGR/F", "functions/groups", "application/vnd.sap.adt.functions.groups.v3+xml"]
+]
+
+const response = (body: string) => ({ status: 200, statusText: "OK", headers: {}, body })
+function setup(path: string, accepts: string[], other = "") {
+  const http = new AdtHTTP("https://example.invalid", "DEV_USER", "unused", "001", "EN")
+  const discovery = `<app:service><app:workspace>${other}<app:collection href="${path}">${accepts.map(value => `<app:accept>${value}</app:accept>`).join("")}</app:collection></app:workspace></app:service>`
+  const request = jest.spyOn(http, "request").mockImplementation(async url => response(url === "/sap/bc/adt/discovery" ? discovery : ""))
+  return { http, request }
+}
+
+describe("collection creation media negotiation", () => {
+  test.each(contracts)("selects the advertised XML representation for %s", async (objtype, path, media) => {
+    const { http, request } = setup("/sap/bc/adt/" + path, ["text/html", media, "application/json"])
+    const options = { objtype, name: "ZEXAMPLE", parentName: "ZPACKAGE", parentPath: "/sap/bc/adt/packages/zpackage", description: "Example", swcomp: "HOME", transportLayer: "DEV", packagetype: "development" } as NewObjectOptions
+    await createObject(http, options)
+    expect(request.mock.calls[1]).toEqual(["/sap/bc/adt/" + path, expect.objectContaining({ headers: { "Content-Type": media }, method: "POST" })])
+  })
+
+  test("does not take an XML format from an unrelated collection", async () => {
+    const { http, request } = setup("/sap/bc/adt/oo/interfaces", ["application/vnd.sap.adt.oo.interfaces.v5+xml"])
+    await createObject(http, { objtype: "DCLS/DL", name: "ZEXAMPLE", parentName: "ZPACKAGE", parentPath: "", description: "Example" })
+    expect(request.mock.calls[1][1]!.headers).toEqual({ "Content-Type": "application/*" })
+  })
+
+  test("combines duplicate collections and accepts an absolute href with a trailing slash", async () => {
+    const media = "application/vnd.sap.adt.dclSource+xml"
+    const { http, request } = setup("https://example.invalid/sap/bc/adt/acm/dcl/sources/", [media], '<app:collection href="/sap/bc/adt/acm/dcl/sources"/>')
+    await createObject(http, { objtype: "DCLS/DL", name: "ZEXAMPLE", parentName: "ZPACKAGE", parentPath: "", description: "Example" })
+    expect(request.mock.calls[1][1]!.headers).toEqual({ "Content-Type": media })
+  })
+})
