diff --git a/src/api/creationowner.test.ts b/src/api/creationowner.test.ts
new file mode 100644
--- /dev/null
+++ b/src/api/creationowner.test.ts
@@ -0,0 +1,19 @@
+import { AdtHTTP } from "../AdtHTTP"
+import { createObject, CreatableTypes, NewObjectOptions } from "./objectcreator"
+import { fullParse } from "../utilities"
+
+describe("repository owner contract", () => {
+  const types = [...CreatableTypes.keys()].filter(type => !["FUGR/FF", "FUGR/I"].includes(type))
+  test.each(types)("does not serialize an overlong login alias for %s", async objtype => {
+    const http = new AdtHTTP("https://example.invalid", "alias@example.invalid", "unused", "001", "EN")
+    const request = jest.spyOn(http, "request").mockResolvedValue({ status: 201, statusText: "Created", body: "", headers: {} })
+    await createObject(http, { objtype, name: "ZEXAMPLE", parentName: "ZPACKAGE", parentPath: "", description: "Example", swcomp: "HOME", transportLayer: "DEV", packagetype: "development", service: "ZSERVICE", bindingtype: "ODATA", category: "1" } as NewObjectOptions)
+    expect(request.mock.calls[1][1]!.body).not.toContain("adtcore:responsible=")
+  })
+  test.each(["DEV_USER", "USER12345678", "A@B", 'A&B"C'])("preserves a valid explicit owner %s", async responsible => {
+    const http = new AdtHTTP("https://example.invalid", "alias@example.invalid", "unused", "001", "EN")
+    const request = jest.spyOn(http, "request").mockResolvedValue({ status: 201, statusText: "Created", body: "", headers: {} })
+    await createObject(http, { objtype: "DCLS/DL", name: "ZEXAMPLE", parentName: "ZPACKAGE", parentPath: "", description: "Example", responsible })
+    expect(fullParse(request.mock.calls[1][1]!.body!)["dcl:dclSource"]["@_adtcore:responsible"]).toBe(responsible.toUpperCase())
+  })
+})
