+describe("class V4 XML", () => {
+  test("serializes the ADT class attributes, include and superclass reference", async () => {
+    const { http, request } = setup()
+    const input = {
+      ...options,
+      language: "en",
+      masterLanguage: "pl",
+      masterSystem: "DEV",
+      responsible: "dev_user"
+    }
+    await createObject(http, input)
+    const root = fullParse(request.mock.calls[1][1]!.body!)["class:abapClass"]
+    expect(root).toMatchObject({
+      "@_xmlns:class": "http://www.sap.com/adt/oo/classes",
+      "@_xmlns:adtcore": "http://www.sap.com/adt/core",
+      "@_adtcore:type": "CLAS/OC",
+      "@_adtcore:name": options.name,
+      "@_adtcore:description": options.description,
+      "@_adtcore:language": "EN",
+      "@_adtcore:masterLanguage": "PL",
+      "@_adtcore:masterSystem": "DEV",
+      "@_adtcore:responsible": "DEV_USER",
+      "@_class:final": true,
+      "@_class:visibility": "public",
+      "adtcore:packageRef": { "@_adtcore:name": options.parentName },
+      "class:include": {
+        "@_adtcore:name": "CLAS/OC",
+        "@_adtcore:type": "CLAS/OC",
+        "@_class:includeType": "testclasses"
+      }
+    })
+    expect(root).toHaveProperty("class:superClassRef")
+    expect(input.responsible).toBe("dev_user")
+  })
+
+  test.each([undefined, "alias@example.invalid"])(
+    "does not infer backend owner from login alias %s",
+    async responsible => {
+      const { http, request } = setup()
+      await createObject(http, { ...options, responsible })
+      const root = fullParse(request.mock.calls[1][1]!.body!)["class:abapClass"]
+      expect(root["@_adtcore:language"]).toBe("DE")
+      expect(root["@_adtcore:masterLanguage"]).toBe("DE")
+      expect(root).not.toHaveProperty("@_adtcore:responsible")
+      expect(root).not.toHaveProperty("@_adtcore:masterSystem")
+      expect(request.mock.calls[1][1]!.qs).toEqual({})
+    }
+  )
+
+  test("escapes context attributes", async () => {
+    const { http, request } = setup()
+    await createObject(http, {
+      ...options,
+      parentName: 'Z&A"B',
+      name: 'Z&A"C',
+      masterSystem: 'D&E"V'
+    })
+    const root = fullParse(request.mock.calls[1][1]!.body!)["class:abapClass"]
+    expect(root["adtcore:packageRef"]["@_adtcore:name"]).toBe('Z&A"B')
+    expect(root["@_adtcore:name"]).toBe('Z&A"C')
+    expect(root["@_adtcore:masterSystem"]).toBe('D&E"V')
+  })
+
+  test("leaves DDLS and other object contracts unchanged", async () => {
+    const { http, request } = setup()
+    await createObject(http, { ...options, objtype: "DDLS/DF", language: "en" })
+    expect(request).toHaveBeenCalledTimes(1)
+    const [url, config] = request.mock.calls[0]
+    expect(url).toBe("/sap/bc/adt/ddic/ddl/sources")
+    expect(config!.headers).toEqual({ "Content-Type": "application/*" })
+    const root = fullParse(config!.body!)["ddl:ddlSource"]
+    expect(root["@_adtcore:language"]).toBe("en")
+    expect(root).not.toHaveProperty("class:include")
+  })
+})
